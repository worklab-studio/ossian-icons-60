  "description": "MCP server for Iconstack — search 51,000+ icons across 21 libraries and insert SVGs without leaving Cursor, Claude Desktop, or Windsurf.",
  "type": "module",
  "bin": {
    "iconstack-mcp": "./dist/index.js"
  },
  "files": [
