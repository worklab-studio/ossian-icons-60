    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "icons",
    "svg",
    "cursor",
    "claude",
    "windsurf",
    "ai",
    "iconstack"
  ],
  "author": "Iconstack",
  "license": "MIT",
  "homepage": "https://iconstack.io/api",
  "repository": {
    "type": "git",
    "url": "https://github.com/iconstack/iconstack-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  }
}
